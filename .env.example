# TelePakt - zmienne dla frontendu (Vite). Skopiuj do .env.local
# Adres backendu Django (Render). Lokalnie: http://localhost:8000
VITE_API_URL="https://api.telepakt.pl"

# Numer bramki telekonferencyjnej TelePakt (Twilio), np. "+48 22 123 45 67".
# Dopoki pusty, aplikacja pokazuje "numer pojawi sie po uruchomieniu uslugi" (bez wymyslonego numeru).
VITE_ASSISTANT_NUMBER=""

# Backend (backend/.env lub panel Render) - NIGDY nie commituj prawdziwych wartosci:
# DJANGO_SECRET_KEY=...      (wymagane w produkcji)
# DJANGO_DEBUG=True          (tylko lokalnie)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...      (uzywany tez do weryfikacji podpisu webhookow i do kasowania nagran)
# TWILIO_PHONE_NUMBER=+48...
# DATABASE_URL=postgres://...
