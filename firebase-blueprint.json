{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing registration and settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "enum": ["email", "google", "apple"]
        },
        "subscriptionPlan": {
          "type": "string",
          "enum": ["free", "shield", "b2b"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "phoneProtected": {
          "type": "string",
          "maxLength": 32
        },
        "isVerified": {
          "type": "boolean"
        },
        "appleRelayEmail": {
          "type": "boolean"
        }
      },
      "required": ["id", "email", "name", "provider"]
    },
    "BetaSignup": {
      "title": "BetaSignup",
      "description": "Beta test participant signup",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "platform": {
          "type": "string",
          "enum": ["android", "ios"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "rodoConsent": {
          "type": "boolean"
        }
      },
      "required": ["id", "email", "platform", "rodoConsent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection restricted to the document owner"
    },
    "/betaSignups/{signupId}": {
      "schema": "BetaSignup",
      "description": "Beta testing signup submissions"
    }
  }
}
